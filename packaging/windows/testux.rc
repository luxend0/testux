#include <winver.h>

// CMake defines these from project(VERSION); the fallbacks keep a bare rc.exe run working.
#ifndef TESTUX_VERSION
#define TESTUX_VERSION "0.0.0"
#endif
#ifndef TESTUX_VERSION_MAJOR
#define TESTUX_VERSION_MAJOR 0
#define TESTUX_VERSION_MINOR 0
#define TESTUX_VERSION_PATCH 0
#endif

IDI_ICON1 ICON "testux.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TESTUX_VERSION_MAJOR, TESTUX_VERSION_MINOR, TESTUX_VERSION_PATCH, 0
PRODUCTVERSION TESTUX_VERSION_MAJOR, TESTUX_VERSION_MINOR, TESTUX_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "lxuend"
            VALUE "FileDescription", "Testux"
            VALUE "FileVersion", TESTUX_VERSION
            VALUE "InternalName", "testux"
            VALUE "LegalCopyright", "Licensed under the GPL-3.0"
            VALUE "OriginalFilename", "testux.exe"
            VALUE "ProductName", "Testux"
            VALUE "ProductVersion", TESTUX_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
